# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# Easier: run setup.ps1, which writes this file for you.
#
# Gmail requires an App Password, not your normal password:
#   1. Enable 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords -> generate one for "Mail"
#   3. Paste the 16-character value (spaces are fine) as SMTP_PASS
#
# University and workplace Google Workspace accounts often disable app
# passwords. If step 2 offers no option, use a personal Gmail as the SENDER
# and keep your school address as EMAIL_TO.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your16charapppassword
EMAIL_FROM=you@gmail.com
EMAIL_TO=where-you-read-mail@example.com
