# Copy to .env and fill in. NEVER commit .env.
#
# Gmail: you must use an App Password, not your normal password.
#   1. Enable 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords -> generate one for "Mail"
#   3. Paste the 16-character value (spaces are fine) as SMTP_PASS
#
# Penn (sdawda@sas.upenn.edu) is a Google Workspace account and app passwords
# are often disabled by the university. If step 2 shows no app-password option,
# use a personal Gmail as the SENDER and keep EMAIL_TO as your Penn address.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.personal@gmail.com
SMTP_PASS=your16charapppassword
EMAIL_FROM=your.personal@gmail.com
EMAIL_TO=sdawda@sas.upenn.edu
